 * Recupera dati JSON da un endpoint API con gestione timeout ed errori
 * @param {string} url - L'indirizzo dell'API da interrogare
 * @param {number} timeoutMs - Tempo massimo di attesa in millisecondi
 */
async function fetchWithTimeout(url, timeoutMs = 5000) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);

    try {
        const response = await fetch(url, {
            method: 'GET',
            headers: { 'Accept': 'application/json' },
            signal: controller.signal
        });

        clearTimeout(timer);

        if (!response.ok) {
            throw new Error(\`Errore HTTP: \${response.status} (\${response.statusText})\`);
        }

        const data = await response.json();
        console.log('Dati ricevuti con successo:', data);
        return data;

    } catch (error) {
        if (error.name === 'AbortError') {
            console.error('Richiesta annullata: Timeout scaduto.');
        } else {
            console.error('Errore durante il recupero dati:', error.message);
        }
        return null;
    }
}

