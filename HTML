                    <p class="text-xs text-slate-300 line-clamp-2 group-hover:text-white">${item.prompt}</p>
                </div>
            `).join('');
        }

        function loadFromHistory(index) {
            const history = JSON.parse(localStorage.getItem('codeforge_history') || '[]');
            const item = history[index];
            if (!item) return;

            selectLanguage(item.langId);
            document.getElementById('promptInput').value = item.prompt;
            displayResult(item.filename, item.code, item.instructions, item.prism);
            toggleModal('historyModal');
