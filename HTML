import shutil
from pathlib import Path

# Dizionario delle categorie di estensioni
CATEGORIES = {
    "Immagini": [".jpg", ".jpeg", ".png", ".gif", ".webp"],
    "Documenti": [".pdf", ".docx", ".txt", ".xlsx", ".pptx"],
    "Archivi": [".zip", ".rar", ".7z", ".tar", ".gz"],
    "Eseguibili": [".exe", ".msi", ".bat", ".ps1"],
    "Video_Audio": [".mp4", ".mkv", ".mp3", ".wav"]
}

def organize_directory(target_path: str):
    base_dir = Path(target_path)
    
    if not base_dir.exists():
        print(f"Errore: Il percorso '{target_path}' non esiste.")
        return

    moved_files = 0

    for item in base_dir.iterdir():
        if item.is_file():
            ext = item.suffix.lower()
            destination_folder = "Altro"

            for category, extensions in CATEGORIES.items():
                if ext in extensions:
                    destination_folder = category
                    break

            dest_dir = base_dir / destination_folder
            dest_dir.mkdir(exist_ok=True)

            try:
                shutil.move(str(item), str(dest_dir / item.name))
                moved_files += 1
                print(f"Spostato: {item.name} -> {destination_folder}/")
            except Exception as e:
                print(f"Impossibile spostare {item.name}: {e}")

    print(f"\\nOperazione completata! Totale file organizzati: {moved_files}")

if __name__ == "__main__":
    # Organizza automaticamente la cartella Download dell'utente
    downloads_path = str(Path.home() / "Downloads")
    organize_directory(downloads_path)`,
