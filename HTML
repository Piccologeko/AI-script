            luau: {
                filename: 'TsunamiSpawner.lua',
                code: `-- Posizionare questo ServerScript in ServerScriptService
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

-- Configurazione dello Tsunami
local SPAWN_INTERVAL = 30 -- Secondi tra uno tsunami e l'altro
local WAVE_SPEED = 45     -- Studs al secondo
local WAVE_DAMAGE = 100   -- Danno letale al contatto
local START_POS = Vector3.new(0, 15, -250)
local END_POS = Vector3.new(0, 15, 250)

local function spawnTsunami()
    -- Creazione dell'onda tramite Istanza Part
    local wave = Instance.new("Part")
    wave.Name = "TsunamiWave"
    wave.Size = Vector3.new(300, 35, 20)
    wave.Position = START_POS
    wave.Anchored = true
    wave.CanCollide = false
    wave.Material = Enum.Material.Neon
    wave.Color = Color3.fromRGB(0, 140, 255)
    wave.Transparency = 0.25
    wave.Parent = workspace

    -- Gestione collisione e danno con protezione pcall
    local debounce = {}
    wave.Touched:Connect(function(hit)
        local character = hit.Parent
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        if humanoid and not debounce[character] then
            debounce[character] = true
            local success, err = pcall(function()
                humanoid:TakeDamage(WAVE_DAMAGE)
            end)
            if not success then
                warn("Errore nell'applicazione del danno: " .. tostring(err))
            end
        end
    end)

    -- Calcolo durata movimento in base alla distanza
    local distance = (END_POS - START_POS).Magnitude
    local duration = distance / WAVE_SPEED

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(wave, tweenInfo, {Position = END_POS})
    
    tween:Play()
    tween.Completed:Wait()
    wave:Destroy()
end

-- Loop principale ottimizzato con task.wait()
task.spawn(function()
    while true do
        task.wait(SPAWN_INTERVAL)
        spawnTsunami()
    end
