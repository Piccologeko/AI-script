        function renderHistory() {
            const history = JSON.parse(localStorage.getItem('codeforge_history') || '[]');
            document.getElementById('historyCount').textContent = history.length;
            const list = document.getElementById('historyList');

            if (history.length === 0) {
                list.innerHTML = '<p class="text-sm text-slate-500 text-center py-8">Nessuno script salvato nella cronologia recente.</p>';
                return;
            }

            list.innerHTML = history.map((item, index) => `
                <div onclick="loadFromHistory(${index})" class="p-3.5 rounded-xl bg-ide-card hover:bg-slate-800 border border-slate-700/80 cursor-pointer transition group">
