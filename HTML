.SYNOPSIS
    Script di pulizia file temporanei e ottimizzazione rapida per Windows 10/11.
#>

Write-Host "=== Avvio pulizia file temporanei di sistema ===" -ForegroundColor Cyan

# Percorsi delle cartelle temporanee
$TempFolders = @(
    $env:TEMP,
    "C:\\Windows\\Temp",
    "C:\\Windows\\Prefetch"
)

$DeletedCount = 0

